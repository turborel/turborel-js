{
  // The tests and the library they import, compiled to build/ for node:test,
  // with source maps so coverage is told of the TypeScript (RULES.md D11).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "noEmit": false,
    "sourceMap": true,
    "newLine": "lf"
  },
  "include": ["src", "test"]
}
